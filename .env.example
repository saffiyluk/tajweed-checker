APP_NAME=TajweedCheck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional initial administrator. Leave blank unless intentionally seeding one.
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

PYTHON_BINARY=python
WHISPER_MODEL=
HAFALAN_WHISPER_MODEL=tiny
WHISPER_TRANSCRIPTION_TIMEOUT=180
TAJWEED_PREDICTION_TIMEOUT=60
TAJWEED_ENABLE_QURAN_PRONUNCIATION_MODEL=true
QURAN_MUAALEM_MODEL=
QURAN_MUAALEM_DEVICE=
QURAN_MUAALEM_TIMEOUT=120
QURAN_MUAALEM_MIN_MODEL_CONFIDENCE=0.72
QURAN_MUAALEM_HIGH_TARGET_CONFIDENCE=0.82
QURAN_MUAALEM_MIN_TARGET_ALIGNMENT_COVERAGE=0.85
QURAN_MUAALEM_MAX_CONTENT_PER=0.35
QURAN_MUAALEM_MAX_CORRECT_TARGET_PER=0.10
QURAN_MUAALEM_ENABLE_AUDIO_CLEANING=true
QURAN_MUAALEM_NOISE_REDUCTION_AMOUNT=0.18
QURAN_MUAALEM_TARGET_RMS=0.08
TAJWEED_ENABLE_HYBRID_RULE_AUDIO_FALLBACK=true
TAJWEED_HYBRID_RULE_AUDIO_MIN_CONFIDENCE=68
TAJWEED_TARGET_ML_TRUST_THRESHOLD=0.78
TAJWEED_TARGET_ML_STRONG_THRESHOLD=0.88
TAJWEED_ELONGATION_THRESHOLD_MS=50
TAJWEED_ELONGATION_LOCAL_WINDOW_SECONDS=0.60
TAJWEED_USE_NOISEREDUCE_LIBRARY=false
TAJWEED_LIBROSA_TRIM_TOP_DB=28
TAJWEED_USE_FIREBASE_STORAGE=false
TAJWEED_FIREBASE_CONNECT_TIMEOUT=3
TAJWEED_FIREBASE_DOWNLOAD_TIMEOUT=10
TAJWEED_ENABLE_FIRESTORE_SYNC=false
TAJWEED_ENABLE_SERVICE_ANALYSIS=false
TAJWEED_ENABLE_TRANSCRIPTION=true
TAJWEED_MIN_BROWSER_TRANSCRIPT_LETTERS=8
TAJWEED_ENABLE_DIACRITIZATION=true
TAJWEED_ENABLE_QURAN_MATCHING=true
TAJWEED_QURAN_MATCH_THRESHOLD=72
TAJWEED_MIN_SELECTED_AYAH_MATCH_LETTERS=8
TAJWEED_SELECTED_AYAH_MATCH_THRESHOLD=62
TAJWEED_SELECTED_AYAH_NEAR_EXACT_MATCH_THRESHOLD=90
TAJWEED_SELECTED_AYAH_COORDINATE_MISMATCH_MIN_SCORE=85
TAJWEED_SELECTED_AYAH_COORDINATE_MISMATCH_MIN_MARGIN=5
TAJWEED_ENABLE_AI_FEEDBACK=false
TAJWEED_ENABLE_RULE_BASED_ANALYSIS=true

# Required only when Firebase storage or Firestore synchronization is enabled.
FIREBASE_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
